generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model users {
  id                      String                    @id @db.Uuid
  wallets                 wallets[]
  blockchain_transactions blockchain_transactions[]
  token_balances          token_balances[]
  nfts                    nfts[]
  staking_positions       staking_positions[]
  rewards_history         rewards_history[]
}

model wallets {
  id                      String                    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  user_id                 String                    @db.Uuid
  address                 String                    @db.VarChar(42)
  network                 String?                   @default("POLYGON") @db.VarChar(50)
  is_primary              Boolean?                  @default(false)
  is_verified             Boolean?                  @default(false)
  nonce                   String?                   @db.VarChar(255)
  created_at              DateTime?                 @default(now()) @db.Timestamptz(6)
  updated_at              DateTime?                 @default(now()) @db.Timestamptz(6)

  user                    users                     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  transactions            blockchain_transactions[]
  token_balances          token_balances[]
  nfts                    nfts[]
  staking_positions       staking_positions[]

  @@unique([address, network])
}

model blockchain_transactions {
  id               String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  user_id          String    @db.Uuid
  wallet_id        String?   @db.Uuid
  tx_hash          String    @unique @db.VarChar(100)
  transaction_type String    @db.VarChar(50)
  amount           Decimal   @db.Decimal(20,8)
  token_address    String?   @db.VarChar(42)
  from_address     String?   @db.VarChar(42)
  to_address       String?   @db.VarChar(42)
  status           String?   @default("PENDING") @db.VarChar(50)
  block_number     BigInt?
  gas_used         Decimal?  @db.Decimal(20,8)
  gas_price        Decimal?  @db.Decimal(20,8)
  metadata         Json?
  created_at       DateTime? @default(now()) @db.Timestamptz(6)
  updated_at       DateTime? @default(now()) @db.Timestamptz(6)

  user             users     @relation(fields: [user_id], references: [id])
  wallet           wallets?  @relation(fields: [wallet_id], references: [id])
}

model token_balances {
  id             String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  user_id        String    @db.Uuid
  wallet_id      String?   @db.Uuid
  token_address  String    @db.VarChar(42)
  symbol         String?   @db.VarChar(20)
  balance        Decimal?  @default(0) @db.Decimal(20,8)
  locked_balance Decimal?  @default(0) @db.Decimal(20,8)
  updated_at     DateTime? @default(now()) @db.Timestamptz(6)

  user           users     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  wallet         wallets?  @relation(fields: [wallet_id], references: [id], onDelete: Cascade)

  @@unique([wallet_id, token_address])
}

model nfts {
  id               String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  user_id          String    @db.Uuid
  wallet_id        String?   @db.Uuid
  contract_address String    @db.VarChar(42)
  token_id         String    @db.VarChar(100)
  metadata_uri     String?
  metadata         Json?
  status           String?   @default("MINTED") @db.VarChar(50)
  mint_tx_hash     String?   @db.VarChar(100)
  created_at       DateTime? @default(now()) @db.Timestamptz(6)
  updated_at       DateTime? @default(now()) @db.Timestamptz(6)

  user             users     @relation(fields: [user_id], references: [id])
  wallet           wallets?  @relation(fields: [wallet_id], references: [id])

  @@unique([contract_address, token_id])
}

model staking_positions {
  id           String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  user_id      String    @db.Uuid
  wallet_id    String?   @db.Uuid
  pool_id      String    @db.VarChar(50)
  amount       Decimal   @db.Decimal(20,8)
  locked_until DateTime? @db.Timestamptz(6)
  reward_debt  Decimal?  @default(0) @db.Decimal(20,8)
  status       String?   @default("ACTIVE") @db.VarChar(50)
  created_at   DateTime? @default(now()) @db.Timestamptz(6)
  updated_at   DateTime? @default(now()) @db.Timestamptz(6)

  user         users     @relation(fields: [user_id], references: [id])
  wallet       wallets?  @relation(fields: [wallet_id], references: [id])
}

model rewards_history {
  id           String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  user_id      String    @db.Uuid
  reward_type  String    @db.VarChar(50)
  amount       Decimal   @db.Decimal(20,8)
  reference_id String?   @db.Uuid
  tx_hash      String?   @db.VarChar(100)
  claimed_at   DateTime? @default(now()) @db.Timestamptz(6)

  user         users     @relation(fields: [user_id], references: [id])
}
